generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Student {
  id              String   @id @default(cuid())
  admissionNumber String   @unique
  name            String
  className       String
  guardianName    String
  guardianPhone   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

