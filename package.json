{
  "name": "school-fee-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:prepare": "node --env-file-if-exists=.env scripts/prepare-db.mjs && prisma generate",
    "db:check": "node --env-file-if-exists=.env scripts/prepare-db.mjs --check",
    "db:local:reset": "node --env-file-if-exists=.env scripts/reset-local-db.mjs && prisma generate",
    "db:cloud:status": "node --env-file-if-exists=.env.cloud.local scripts/cloud-db.mjs status",
    "db:cloud:deploy": "node --env-file-if-exists=.env.cloud.local scripts/cloud-db.mjs deploy",
    "staff:cloud:create": "node --env-file-if-exists=.env.cloud.local scripts/cloud-db.mjs create-staff",
    "test:integration": "node --env-file-if-exists=.env scripts/test-fees.mjs",
    "staff:create": "node --experimental-strip-types --env-file-if-exists=.env scripts/create-user.mjs",
    "staff:reset-password": "node --experimental-strip-types --env-file-if-exists=.env scripts/reset-password.mjs",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "^6.19.0",
    "zod": "^4.0.0",
    "react-hook-form": "^7.0.0",
    "@hookform/resolvers": "^5.0.0",
    "@tanstack/react-table": "^8.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "@radix-ui/react-slot": "^1.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "prisma": "^6.19.0",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0"
  }
}
