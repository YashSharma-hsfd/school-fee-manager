# Copy to .env.cloud.local only if that file does not already exist.
# Enter the two connection strings privately; this template contains no credentials.
# The app's existing .env remains your LOCAL database configuration.

# Supabase pooler connection (transaction port 6543 requires pgbouncer=true), with sslmode=require, for the deployed application's DATABASE_URL.
CLOUD_DATABASE_URL=""

# Supabase session pooler port 5432 (IPv4) or direct endpoint (IPv6), with sslmode=require, for cloud migration commands only.
CLOUD_DIRECT_URL=""

# Project reference from Supabase project settings.
CLOUD_PROJECT_REF=""

