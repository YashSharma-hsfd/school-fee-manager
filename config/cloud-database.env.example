# Copy to .env.cloud.local only if that file does not already exist.
# Enter the two connection strings privately; this template contains no credentials.
# The app's existing .env remains your LOCAL database configuration.

# Neon pooled connection, with sslmode=require, for the deployed application's DATABASE_URL.
CLOUD_DATABASE_URL=""

# Neon unpooled/direct connection, with sslmode=require, for cloud migration commands only.
CLOUD_DIRECT_URL=""
